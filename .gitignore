# Editor / OS
.vscode/
.venv/
.DS_Store
Thumbs.db

# Machine-specific tool/modlist paths — never commit. Copy from tools.example.json.
/.claude/config/tools.json

# Wabbajack modlists installed into the repo — HUNDREDS of GB, third-party content.
# Includes the game copy, mods, tools (Creation Kit, Papyrus compiler), and downloads.
# Install anywhere and point .claude/config/tools.json at it; if you install under the
# repo, keep it in this gitignored folder. See the modlist-install skill.
/modlist/
/downloads/

# Binary Bethesda plugins — never commit. Edit the YAML, deserialize to build these.
# CAUTION: Spriggit names its YAML cell/worldspace record *folders*
# "<Name> - <FormID>_<Master>.esp" (or .esm/.esl), so a bare "*.esp" glob would ignore
# the committed source tree. So: ignore plugin FILES with these extensions at any depth,
# then re-include DIRECTORIES ending in them (the trailing "/" restricts to folders) so
# their YAML contents stay tracked.
*.esp
*.esm
*.esl
!*.esp/
!*.esm/
!*.esl/

# Build output only — the build SCRIPTS (build/build.ps1, build/manifest.json) and the committed
# FOMOD source under build/releases/<name>/fomod/ stay tracked; just the derived staging tree and
# packed archives are ignored.
/build/staging/
/build/dist/

# Bethesda archives — large binaries, never commit. Extract scripts with bsa-extract.
*.bsa
*.ba2

# Packaged release archives (Nexus uploads etc.) — large binaries, rebuild from source.
*.7z

# Papyrus & packaging build artifacts — derivable, do NOT commit. Source of truth =
# the Spriggit YAML under src/ + src/WintersunNordicAddon/NordicAddonScripts/source/*.psc.
*.pex
/dist/

# Spriggit CLI downloaded by the CI composite action (cached, never committed).
/.tools/

# EXCEPTION: the addon's canonical compiled scripts ARE committed so cloud CI can
# package without a Creation Kit. Recompile + commit these whenever a .psc changes
# (see the "CI build" section in README.md); build/build.ps1 fails if any are missing.
!src/WintersunNordicAddon/NordicAddonScripts/compiled/
!src/WintersunNordicAddon/NordicAddonScripts/compiled/*.pex

# Vanilla / reference decompiles — large, regenerated from local plugins, do NOT commit.
# These are third-party/vanilla mods you serialize ONLY for FormKey lookups.
# Add one block per reference master you decompile (examples commented out below).
/_reference/
/_reference/*
# This workspace's reference tree (Wintersun ESP + scripts, etc.) — same rule:
# third-party lookup material, re-serialized locally from each machine's own copy.
/reference/
# e.g.
# /skyrimBaseGame/
# /skyrimBaseGameUpdate/
# /<sourceModName>/
