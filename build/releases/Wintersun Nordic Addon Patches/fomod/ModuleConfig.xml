<?xml version="1.0" encoding="utf-8"?>
<!--
  FOMOD installer for the patch collection. Every patch is optional; tick only the ones whose
  target mod you actually run. All of them master onto WintersunNordicDivines.esp, so the main
  addon must be installed and enabled first.

  This file is SOURCE (committed). build/build.ps1 copies build/releases/<name>/fomod/ into
  build/staging/<name>/fomod/ and packs the staging tree; nothing under build/staging/ is tracked.

  Every source= that ends in .esp must match a "dest" in build/manifest.json - `build/build.ps1
  -CheckFomod` fails the build otherwise. Image path= attributes (if you add any) are relative to
  the ARCHIVE ROOT, so they must carry the "fomod\" prefix themselves and use backslashes.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>Wintersun Nordic Addon - Patches</moduleName>

    <installSteps order="Explicit">
        <installStep name="Cities, Towns and Villages">
            <optionalFileGroups order="Explicit">
                <group name="Settlement overhauls - tick the ones you run" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="Amber Guard">
                            <description>Places the addon's shrines in Amber Guard. Requires Amber Guard.esp.</description>
                            <files>
                                <file source="NordicWintersunAmberGuardPatch.esp" destination="NordicWintersunAmberGuardPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Capital Windhelm Expansion">
                            <description>Shrine placement for Capital Windhelm Expansion, including the Tsun cult HQ interior. Requires WindhelmSSE.esp.</description>
                            <files>
                                <file source="NordicWintersunCapitalWindhelmPatch.esp" destination="NordicWintersunCapitalWindhelmPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Granite Hill">
                            <description>Shrine placement for Granite Hill. Requires Granite Hill.esp.</description>
                            <files>
                                <file source="NordicWintersunGraniteHillPatch.esp" destination="NordicWintersunGraniteHillPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="The Great City of Winterhold">
                            <description>Shrine placement for The Great City of Winterhold. Requires The Great City of Winterhold v4.esp.</description>
                            <files>
                                <file source="NordicWintersunTGCWinterholdPatch.esp" destination="NordicWintersunTGCWinterholdPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="The Great Town of Ivarstead">
                            <description>Shrine placement for The Great Town of Ivarstead (Hall of Kyne). Requires The Great Town of Ivarstead.esp.

Pick this OR the Thuldor's Ivarstead patch below - whichever Ivarstead overhaul you actually run - not both.</description>
                            <files>
                                <file source="NordicWintersunTGTIvarsteadPatch.esp" destination="NordicWintersunTGTIvarsteadPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Thuldor's Ivarstead">
                            <description>Shrine placement for Thuldor's Ivarstead (temple interior). Requires Thuldor's Ivarstead.esp.

Pick this OR The Great Town of Ivarstead patch above, not both.</description>
                            <files>
                                <file source="NordicWintersunThuldorsIvarstead.esp" destination="NordicWintersunThuldorsIvarstead.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="The Great Village of Kynesgrove">
                            <description>Shrine placement for The Great Village of Kynesgrove (Hall of Kyne). Requires The Great Village of Kynesgrove.esp.</description>
                            <files>
                                <file source="NordicWintersunTGVKynesgrovePatch.esp" destination="NordicWintersunTGVKynesgrovePatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Winterhold Restored">
                            <description>Shrine placement for Winterhold Restored. Requires Winterhold Restored.esp.</description>
                            <files>
                                <file source="NordicWintersunWinterholdRestoredPatch.esp" destination="NordicWintersunWinterholdRestoredPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>

        <installStep name="Shrines and Temples">
            <optionalFileGroups order="Explicit">
                <group name="Shrine and temple mods - tick the ones you run" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="Ancient Nordic Temple">
                            <description>Shrine placement for the Ancient Nordic Temple. Requires Ancient Nordic Temple - 12h.esp.</description>
                            <files>
                                <file source="NordicWintersunAncientNordicTemplePatch.esp" destination="NordicWintersunAncientNordicTemplePatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Shrine to Kyne">
                            <description>Wires the standalone Shrine to Kyne up to the addon's Kyne worship. Requires Shrine2Kyne.esp.</description>
                            <files>
                                <file source="Nordic Wintersun - Shrine to Kyne.esp" destination="Nordic Wintersun - Shrine to Kyne.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Stave Churches 2024 - AIO">
                            <description>For the all-in-one build of Stave Churches 2024. Requires Stave Church 2024 AIO.esp.

Use this OR the three per-city patches below - matching which version of Stave Churches you installed - never both.</description>
                            <files>
                                <file source="Nordic Wintersun - Stave Church AIO.esp" destination="Nordic Wintersun - Stave Church AIO.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Stave Churches 2024 - Dawnstar">
                            <description>For the standalone Dawnstar stave church. Requires Stave Church 2024 - Dawnstar.esp.</description>
                            <files>
                                <file source="Nordic Wintersun - Stave Church Dawnstar.esp" destination="Nordic Wintersun - Stave Church Dawnstar.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Stave Churches 2024 - Ivarstead">
                            <description>For the standalone Ivarstead stave church. Requires Stave Church 2024 - Ivarstead.esp.</description>
                            <files>
                                <file source="Nordic Wintersun - Stave Church Ivarstead.esp" destination="Nordic Wintersun - Stave Church Ivarstead.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Stave Churches 2024 - Windhelm">
                            <description>For the standalone Windhelm stave church. Requires Stave Church 2024 - Windhelm.esp.</description>
                            <files>
                                <file source="Nordic Wintersun - Stave Church Windhelm.esp" destination="Nordic Wintersun - Stave Church Windhelm.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>

        <installStep name="Gameplay and Religion Mods">
            <optionalFileGroups order="Explicit">
                <group name="Gameplay mods - tick the ones you run" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="Berserkyr">
                            <description>Reconciles Berserkyr's rage mechanics with the addon's deities. Requires Tales of Skyrim - Berserkyr.esp and Wintersun - Faiths of Skyrim.esp.</description>
                            <files>
                                <file source="Nordic Wintersun - Berserkyr.esp" destination="Nordic Wintersun - Berserkyr.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Children of the Sky">
                            <description>Reconciles Children of the Sky with the addon's Nordic pantheon. Requires Children of the Sky.esp.</description>
                            <files>
                                <file source="Nordic Wintersun - Children of the Sky.esp" destination="Nordic Wintersun - Children of the Sky.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="Skyrim's Got Talent">
                            <description>Lets bard performances earn favor with the Nordic aspect of Dibella. Requires SkyrimsGotTalent-Bards.esp and Wintersun - Faiths of Skyrim.esp.

Installs one script (WSN_SGT_DibellaMusicFavor_Script.pex) alongside the plugin.</description>
                            <files>
                                <file source="Nordic Wintersun - Skyrims Got Talent.esp" destination="Nordic Wintersun - Skyrims Got Talent.esp"/>
                                <folder source="Scripts" destination="Scripts"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                        <plugin name="The Old Ways - Nordic Religion">
                            <description>Reconciles The Old Ways with the addon's tenets and shrines. Requires The Old Ways - Nordic Religion.esp and Wintersun - Faiths of Skyrim.esp.</description>
                            <files>
                                <file source="NordicWintersunTheOldWaysPatch.esp" destination="NordicWintersunTheOldWaysPatch.esp"/>
                            </files>
                            <typeDescriptor><type name="Optional"/></typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
</config>
