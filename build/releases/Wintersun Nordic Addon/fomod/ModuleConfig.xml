<?xml version="1.0" encoding="utf-8"?>
<!--
  FOMOD installer for the main addon.

  This file is SOURCE (committed). build/build.ps1 copies build/releases/<name>/fomod/ into
  build/staging/<name>/fomod/ and packs the staging tree; nothing under build/staging/ is tracked.

  Every source= that ends in .esp must match a "dest" in build/manifest.json - `build/build.ps1
  -CheckFomod` fails the build otherwise. Image path= attributes (if you add any) are relative to
  the ARCHIVE ROOT, so they must carry the "fomod\" prefix themselves and use backslashes.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>Wintersun Nordic Addon</moduleName>

    <requiredInstallFiles>
        <file source="WintersunNordicDivines.esp" destination="WintersunNordicDivines.esp"/>
        <folder source="Scripts" destination="Scripts"/>
    </requiredInstallFiles>

    <installSteps order="Explicit">
        <installStep name="Optional Patch">
            <optionalFileGroups order="Explicit">
                <group name="Creation Club - Tribunal" type="SelectAny">
                    <plugins order="Explicit">
                        <plugin name="Tribunal Patch">
                            <description>Adds the Tribunal (Almalexia, Sotha Sil, Vivec) to the addon's deity roster.

REQUIRES all of: the Almsivi Creation Club content (ccasvsse001-almsivi.esm), Wintersun - GotT Patch.esp, and Dragonborn.esm. Do NOT tick this box unless every one of those is installed and enabled - the plugin will not load without them.</description>
                            <files>
                                <file source="WintersunNordicAddonTribunalPatch.esp" destination="WintersunNordicAddonTribunalPatch.esp"/>
                            </files>
                            <typeDescriptor>
                                <type name="Optional"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>
</config>
